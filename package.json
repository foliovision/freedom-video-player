{
  "name": "freedomplayer",
  "version": "7.2.15",
  "description": "The HTML5 video player for the web",
  "main": "dist/freedomplayer.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mochify ./test/unit/*.js",
    "test-watch": "mochify -w ./test/unit/*.js",
    "fixmeprepublish": "make clean && make skin && make min && make",
    "testBundle": "browserify -o dist/test-bundle.js test/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/foliovision/freedom-video-player.git"
  },
  "author": "",
  "license": "GPLv3",
  "bugs": {
    "url": "https://github.com/foliovision/freedom-video-player/issues"
  },
  "jshintConfig": {
    "browser": true,
    "node": true,
    "strict": true,
    "newcap": false,
    "multistr": true
  },
  "dependencies": {
    "bean": "github:foliovision/bean",
    "class-list": "~0.1.1",
    "computed-style": "^0.3.0",
    "extend-object": "~1.0.0",
    "is-function": "~1.0.2",
    "scriptjs": "^2.5.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "brfs": "^2.0.2",
    "browserify": "^17.0.1",
    "browserify-derequire": "^1.1.1",
    "cssnano": "^7.1.1",
    "mochify": "^8.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-combine-media-query": "^2.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "sass": "^1.93.2",
    "uglify-js": "^3.19.3"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {},
      "postcss-combine-duplicated-selectors": {
        "removeDuplicatedProperties": true
      },
      "postcss-combine-media-query": {},
      "cssnano": {
        "preset": [
          "default",
          {
            "discardComments": {
              "removeAll": true
            }
          }
        ]
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-css-order"
    ],
    "cssDeclarationSorterOrder": "smacss"
  }
}
